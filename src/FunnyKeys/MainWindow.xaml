<Window x:Class="FunnyKeys.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FunnyKeys" Width="1100" Height="830" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#101217" Foreground="#F1F3F5" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.InputBindings><KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding AudioDiagnosticsCommand}"/></Window.InputBindings>
  <Grid Margin="30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <StackPanel Orientation="Horizontal"><Border Background="#BAF264" CornerRadius="12" Width="46" Height="46"><TextBlock Text="F))" Foreground="#101217" FontWeight="Black" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="FunnyKeys" FontSize="25" FontWeight="Bold"/><TextBlock Text="SMALL KEYS. BIG PERSONALITY." FontSize="10" Foreground="#9FA5B2"/></StackPanel></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#20252E" CornerRadius="6" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="{Binding HotkeyLabel}" Foreground="#AEB6C3" FontSize="12"/></Border><Button Content="Exit FunnyKeys" Command="{Binding ExitCommand}" Padding="12,8" ToolTip="Stop sounds and completely quit"/></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.16*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource Card}" Background="#1C2520" BorderBrush="#3A4F35" Margin="0,0,0,18">
            <StackPanel>
              <DockPanel><TextBlock Text="YOUR KEYBOARD, REMIXED" Style="{StaticResource Label}"/><Border HorizontalAlignment="Right" CornerRadius="6" Padding="8,4"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#442D33"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Background" Value="#31492C"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFA4AB"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Foreground" Value="#BAF264"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DockPanel>
              <TextBlock Text="Make some noise." FontSize="34" FontWeight="Bold" Margin="0,12,0,4"/>
              <TextBlock Text="A little chaos for every keystroke. Works wherever you type." Foreground="#AAB6AA" Margin="0,0,0,20"/>
              <TextBlock Text="{Binding MasterLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Background="#BAF264" Foreground="#152015" BorderBrush="#BAF264" Padding="20,14" ToolTip="Toggle global keyboard sound effects"/>
              <TextBlock Text="{Binding Activity}" FontSize="11" Foreground="#AAB6AA" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="NOW PLAYING" Style="{StaticResource Label}"/>
              <ComboBox ItemsSource="{Binding Sounds}" SelectedItem="{Binding SelectedSound}" DisplayMemberPath="Name" AutomationProperties.Name="Current sound"/>
              <Grid Margin="0,12,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="▶  Preview sound" Command="{Binding PreviewCommand}"/><Button Grid.Column="2" Content="■  Stop audio" Command="{Binding StopCommand}"/></Grid>
              <DockPanel><TextBlock Text="VOLUME" Style="{StaticResource Label}"/><TextBlock Text="{Binding Volume, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="#BAF264"/></DockPanel>
              <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="1" AutomationProperties.Name="Volume" Margin="0,0,0,16"/>
              <CheckBox Content="Random sound on every press" IsChecked="{Binding RandomMode}" ToolTip="Uses the sounds checked in the library. No checked sounds means silence."/>
              <CheckBox Content="CHAOS MODE" IsChecked="{Binding ChaosMode}" Foreground="#BAF264" ToolTip="Random sounds and varied loudness, never above your master volume"/>
              <TextBlock Text="Chaos uses your random pool with a little volume variation." Foreground="#929BAA" FontSize="11" Margin="26,0,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel><TextBlock Text="FEEL &amp; TIMING" Style="{StaticResource Label}"/>
              <TextBlock Text="Sound playback mode" Margin="0,4,0,8"/><ComboBox ItemsSource="{Binding PlaybackOptions}" SelectedIndex="{Binding PlaybackIndex}" AutomationProperties.Name="Sound playback mode"/>
              <TextBlock Text="Key repeat" Margin="0,16,0,8"/><ComboBox ItemsSource="{Binding RepeatOptions}" SelectedIndex="{Binding RepeatIndex}" AutomationProperties.Name="Key repeat"/>
              <TextBlock Text="{Binding RepeatNotice}" Foreground="#EBCB8B" FontSize="12" Margin="0,10,0,8"/>
              <Button Content="Use once-per-press settings" Command="{Binding SinglePressCommand}" FontSize="12"/>
              <CheckBox Content="Include Shift, Ctrl, Alt and Windows keys" IsChecked="{Binding IncludeModifiers}" Margin="0,16,0,16"/>
              <DockPanel><TextBlock Text="Minimum sound interval"/><TextBlock Text="{Binding MinimumInterval, StringFormat={}{0} ms}" HorizontalAlignment="Right" Foreground="#BAF264"/></DockPanel>
              <Slider Minimum="0" Maximum="500" TickFrequency="25" Value="{Binding MinimumInterval}" AutomationProperties.Name="Minimum sound interval" Margin="0,12,0,0"/>
              <TextBlock Text="Set to 0 for every press. A small gap keeps rapid typing under control." Foreground="#929BAA" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
              <DockPanel Margin="0,0,0,5"><TextBlock Text="Sound library" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding LibraryCount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#9FA5B2"/></DockPanel>
              <TextBlock Text="Select a row to use it. Check sounds for your random pool." FontSize="12" Foreground="#9FA5B2" Margin="0,0,0,16"/>
              <ListBox ItemsSource="{Binding Sounds}" SelectedItem="{Binding SelectedSound}" Background="Transparent" BorderThickness="0" MaxHeight="430" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sound library">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="#21252E" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#BAF264"/><Setter TargetName="Row" Property="Background" Value="#293426"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding RandomEnabled}" ToolTip="Include in random mode" AutomationProperties.Name="Include in random mode"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#949EAD" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="▶" Padding="8" Margin="4,0,0,0" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Preview this sound" AutomationProperties.Name="Preview this sound"/></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Content="+  Add custom sound" Command="{Binding ImportCommand}" Margin="0,14,0,8"/>
              <Button Content="Remove selected custom sound" Command="{Binding RemoveCommand}" FontSize="12" Padding="8" Background="Transparent" ToolTip="Removes the app's copy; preserves your original file"/>
              <TextBlock Text="WAV &amp; MP3 · up to 15 seconds / 20 MB&#10;AAC, M4A and FLAC when supported by Windows." FontSize="10" Foreground="#929BAA" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel><TextBlock Text="MAKE YOURSELF AT HOME" Style="{StaticResource Label}"/>
              <CheckBox Content="Start FunnyKeys with Windows" IsChecked="{Binding StartWithWindows}"/>
              <CheckBox Content="Start minimized in the tray" IsChecked="{Binding StartMinimized}"/>
              <CheckBox Content="Minimize and close to system tray" IsChecked="{Binding MinimizeToTray}"/>
              <Border Height="1" Background="#333944" Margin="0,16"/>
              <Button Content="Advanced: Audio diagnostics" Command="{Binding AudioDiagnosticsCommand}" ToolTip="Ctrl + Shift + D (while FunnyKeys is focused)" Margin="0,0,0,16"/>
              <TextBlock Text="LOCAL BY DESIGN" Foreground="#BAF264" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
              <TextBlock Text="FunnyKeys listens for keyboard presses locally to trigger sound effects. Keystrokes are not recorded, stored, or transmitted." Foreground="#9FA5B2" FontSize="12"/>
              <TextBlock Text="FunnyKeys 1.0.2 · Original synth sound pack" Foreground="#747E8D" FontSize="10" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#202630" CornerRadius="8" Padding="12" Margin="0,16,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissCommand}" Padding="8,0" Margin="10,0,0,0" ToolTip="Dismiss message"/><TextBlock Text="{Binding Message}" FontSize="12" Foreground="#CBD2DD" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
</Window>

